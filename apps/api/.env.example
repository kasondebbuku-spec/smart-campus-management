# Copy to .env (or set these in your host's settings).

# PostgreSQL. With docker compose:  postgresql://campus:campus@localhost:5432/smart_campus?schema=public
DATABASE_URL="postgresql://campus:campus@localhost:5432/smart_campus?schema=public"

# Throwaway database for the integration tests. They are skipped when this is empty.
TEST_DATABASE_URL="postgresql://campus:campus@localhost:5432/smart_campus_test?schema=public"

# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""

PORT=4000
# Comma-separated origins allowed to call the API with cookies (the web app)
CORS_ORIGINS="http://localhost:3000"

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@campus.test"
SEED_ADMIN_PASSWORD=""
